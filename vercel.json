{
  "crons": [
    {
      "path": "/api/daily-report",
      "schedule": "30 2 1 * *"
    }
  ],
  "rewrites": [
    { "source": "/", "destination": "/login.html" },
    { "source": "/admin", "destination": "/admin.html" },
    { "source": "/api/get-public-key", "destination": "/api/get-public-key.js" },
    { "source": "/api/login", "destination": "/api/login.js" },
    { "source": "/api/daily-report", "destination": "/api/daily-report.js" },
    {
  "source": "/api/google-auth",
  "destination": "/api/google-auth.js"
},
{
  "source": "/api/google/callback",
  "destination": "/api/google/callback.js"
}
  ]
}